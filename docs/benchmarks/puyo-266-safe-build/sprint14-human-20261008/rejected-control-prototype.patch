+def _control_reachability(state, pair):
+    """Lazy public fresh-spawn geometry; caller charges before each expansion."""
+    from puyo_env.action_planner import PLANNER_ACTIONS, _transition_piece_state
+    from src.core.game import GameState
+    from src.core.puyo import Puyo
+
+    game = GameState(seed=0)
+    game.state = "control"
+    game.current_puyo_1, game.current_puyo_2 = (Puyo(v) for v in pair)
+    # This geometry sidecar must never consume even a synthetic future queue.
+    game.next_puyo_queue.clear()
+    game.puyo_sequence = None
+    for y, row in enumerate(state.to_color_grid()):
+        for x, color in enumerate(row):
+            game.field.grid[y][x] = Puyo(color)
+    start = (game.puyo_x, game.puyo_y, game.puyo_rot, 0)
+    pending, seen, found = deque([start]), {start}, set()
+
+    def reachable(action):
+        placement = PLACEMENT_ACTIONS[action]
+        landing = game.find_landing_y(placement.axis_x, placement.rotation)
+        if landing is None:
+            return False
+        target = (placement.axis_x, landing, placement.rotation)
+        while target not in found and pending:
+            yield "control"  # Same 128-node survival budget, before expansion.
+            current = pending.popleft()
+            found.add(current[:3])
+            for operation in PLANNER_ACTIONS:
+                following = _transition_piece_state(game, current, operation)
+                if following is not None and following not in seen:
+                    seen.add(following)
+                    pending.append(following)
+        return target in found
+
+    return reachable
 
 
